+/* A window of another process (Chromium's GPU process presents into the browser's window):
+ * render into a CAContext that the window's owner hosts with CALayerHost, as winemac does for
+ * Vulkan. Upstream only does that for top-level windows; for a child window the owner places
+ * the layer over the child's area of its top-level window (host_remote_layer). The swapchain
+ * stands in for the view, and the functions below recognize it. */
+/* Lets launchers tell that this winemac can host other processes' Metal layers for DXMT. */
+__attribute__((visibility("default"))) const int macdrv_remote_metal_layers = 1;
+
+static pthread_mutex_t remote_swapchains_mutex = PTHREAD_MUTEX_INITIALIZER;
+static CFMutableSetRef remote_swapchains;
+
+static BOOL is_remote_swapchain(const void *ptr)
+{
+    BOOL ret;
+
+    pthread_mutex_lock(&remote_swapchains_mutex);
+    ret = ptr && remote_swapchains && CFSetContainsValue(remote_swapchains, ptr);
+    pthread_mutex_unlock(&remote_swapchains_mutex);
+    return ret;
+}
+
+static id_WineMetalSwapChain create_remote_swapchain(HWND hwnd)
+{
+    HWND root = NtUserGetAncestor(hwnd, GA_ROOT);
+    id_WineMetalSwapChain swapchain;
+    RECT rect;
+
+    if (!root || !NtUserGetClientRect(hwnd, &rect, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return NULL;
+    /* Ask the window itself (its owner hosts the layer in the top-level window, placed over it). */
+    if (!(swapchain = macdrv_create_offscreen_swapchain(hwnd, cgrect_from_rect(rect)))) return NULL;
+    TRACE("hwnd %p (root %p) %s: remote swapchain %p\n", hwnd, root, wine_dbgstr_rect(&rect), swapchain);
+
+    pthread_mutex_lock(&remote_swapchains_mutex);
+    if (!remote_swapchains) remote_swapchains = CFSetCreateMutable(NULL, 0, NULL);
+    CFSetAddValue(remote_swapchains, swapchain);
+    pthread_mutex_unlock(&remote_swapchains_mutex);
+    return swapchain;
+}
 
