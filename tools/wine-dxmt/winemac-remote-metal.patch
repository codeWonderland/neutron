+            return;
+        }
+    }
+    macdrv_window_create_ca_layer_host_view(root_data->cocoa_window, context_id);
+    if (hwnd != root_data->hwnd) set_hosted_remote_layer(hwnd, context_id, TRUE);
+}
+
+/* A child window hosting another process's layer moved or resized: place the layer again. */
+static void update_hosted_remote_layers(HWND hwnd)
+{
+    unsigned int ids[ARRAY_SIZE(hosted_remote_layers)], count = 0, i;
+    struct macdrv_win_data *root_data;
+
+    pthread_mutex_lock(&pending_remote_layers_mutex);
+    for (i = 0; i < ARRAY_SIZE(hosted_remote_layers); i++)
+        if (hosted_remote_layers[i].hwnd == hwnd) ids[count++] = hosted_remote_layers[i].context_id;
+    pthread_mutex_unlock(&pending_remote_layers_mutex);
+    if (!count) return;
+
+    if ((root_data = get_win_data(NtUserGetAncestor(hwnd, GA_ROOT))) && root_data->cocoa_window)
