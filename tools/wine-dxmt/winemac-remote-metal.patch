+}
+
+static void attach_pending_remote_layers(struct macdrv_win_data *data)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&pending_remote_layers_mutex);
+    for (i = 0; i < ARRAY_SIZE(pending_remote_layers); i++)
+    {
+        HWND hwnd = pending_remote_layers[i].hwnd;
+        if (!hwnd || (hwnd != data->hwnd && NtUserGetAncestor(hwnd, GA_ROOT) != data->hwnd)) continue;
+        TRACE("hwnd %p: attaching pending remote layer %u\n", hwnd, pending_remote_layers[i].context_id);
+        host_remote_layer(hwnd, data, pending_remote_layers[i].context_id);
+        pending_remote_layers[i].hwnd = 0;
+    }
+    pthread_mutex_unlock(&pending_remote_layers_mutex);
+}
