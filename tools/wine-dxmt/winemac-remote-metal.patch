  *
  * Create the whole Mac window for a given window
  */
+/* Another process's layers (CAContext IDs) for windows of this process. "pending" ones were
+ * requested before the window's top-level window had a Cocoa window (Chromium's GPU process
+ * presenting before Steam's window is shown) and are attached by create_cocoa_window();
+ * "hosted" ones are shown over a child window and follow it when windows move, resize or
+ * change z-order (update_hosted_remote_layers). */
+struct remote_layer
+{
+    HWND hwnd;
+    unsigned int context_id;
+};
+
+struct remote_layer_list
+{
+    struct remote_layer *items;
+    unsigned int count, capacity;
+};
+
+static pthread_mutex_t remote_layers_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct remote_layer_list pending_remote_layers, hosted_remote_layers;
+
+/* Adds or removes (hwnd, context_id), dropping entries for windows that no longer exist (a
+ * child destroyed before its owner was shown is never released). Called with the mutex held. */
+static void remote_layer_list_set(struct remote_layer_list *list, HWND hwnd, unsigned int context_id, BOOL add)
+{
+    unsigned int i, j;
+
+    for (i = j = 0; i < list->count; i++)
+    {
+        struct remote_layer *item = &list->items[i];
+        if ((item->hwnd == hwnd && item->context_id == context_id) || !NtUserIsWindow(item->hwnd)) continue;
+        list->items[j++] = *item;
+    }
+    list->count = j;
+    if (!add) return;
+    if (list->count == list->capacity)
+    {
+        unsigned int capacity = max(16, list->capacity * 2);
+        struct remote_layer *items = realloc(list->items, capacity * sizeof(*items));
+        if (!items) return;
+        list->items = items;
+        list->capacity = capacity;
+    }
+    list->items[list->count].hwnd = hwnd;
+    list->items[list->count].context_id = context_id;
+    list->count++;
+}
+
+static void set_pending_remote_layer(HWND hwnd, unsigned int context_id, BOOL add)
+{
+    pthread_mutex_lock(&remote_layers_mutex);
+    remote_layer_list_set(&pending_remote_layers, hwnd, context_id, add);
+    pthread_mutex_unlock(&remote_layers_mutex);
+}
+
+static void set_hosted_remote_layer(HWND hwnd, unsigned int context_id, BOOL add)
+{
+    pthread_mutex_lock(&remote_layers_mutex);
+    remote_layer_list_set(&hosted_remote_layers, hwnd, context_id, add);
+    pthread_mutex_unlock(&remote_layers_mutex);
+}
+
+/* Copies the entries whose window has root as its top-level window, removing them from the
+ * list when remove is set. The caller frees the result. */
+static struct remote_layer *remote_layers_under(struct remote_layer_list *list, HWND root, BOOL remove,
+                                                unsigned int *count)
+{
+    struct remote_layer *ret;
+    unsigned int i, j;
+
+    *count = 0;
+    pthread_mutex_lock(&remote_layers_mutex);
+    if ((ret = malloc(max(1, list->count) * sizeof(*ret))))
+    {
+        for (i = j = 0; i < list->count; i++)
+        {
+            struct remote_layer *item = &list->items[i];
+            if (item->hwnd == root || NtUserGetAncestor(item->hwnd, GA_ROOT) == root)
+            {
+                ret[(*count)++] = *item;
+                if (remove) continue;
+            }
+            list->items[j++] = *item;
+        }
+        list->count = j;
+    }
+    pthread_mutex_unlock(&remote_layers_mutex);
+    return ret;
+}
+
+/* Counts the windows painted before hwnd under parent (bottom to top, each window before its
+ * children); returns TRUE once hwnd is found. */
+static BOOL paint_order(HWND parent, HWND hwnd, unsigned int *index)
+{
+    HWND child;
+
+    for (child = NtUserGetWindowRelative(NtUserGetWindowRelative(parent, GW_CHILD), GW_HWNDLAST);
+         child; child = NtUserGetWindowRelative(child, GW_HWNDPREV))
+    {
+        (*index)++;
+        if (child == hwnd || paint_order(child, hwnd, index)) return TRUE;
+    }
+    return FALSE;
+}
+
+/* Shows another process's layer for hwnd in root's Cocoa window: filling it when hwnd is the
+ * top-level window or covers its whole area, otherwise over hwnd's client area, stacked like
+ * hwnd among root's descendants. */
+static void host_remote_layer(HWND hwnd, struct macdrv_win_data *root_data, unsigned int context_id)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    RECT rect, visible = root_data->rects.visible;
+    unsigned int z = 0;
+
+    if (hwnd != root_data->hwnd) paint_order(root_data->hwnd, hwnd, &z);
+    if (hwnd != root_data->hwnd && NtUserGetClientRect(hwnd, &rect, dpi))
+    {
+        NtUserMapWindowPoints(hwnd, 0, (POINT *)&rect, 2, dpi);
+        OffsetRect(&rect, -visible.left, -visible.top);
+        if (rect.left || rect.top || rect.right != visible.right - visible.left ||
+            rect.bottom != visible.bottom - visible.top)
+        {
+            TRACE("hwnd %p: remote layer %u at %s z %u in %p\n", hwnd, context_id, wine_dbgstr_rect(&rect), z, root_data->hwnd);
+            macdrv_window_create_ca_layer_host_view_frame(root_data->cocoa_window, context_id, cgrect_from_rect(rect), z);
+            set_hosted_remote_layer(hwnd, context_id, TRUE);
+            return;
+        }
+    }
+    if (hwnd == root_data->hwnd)
+        macdrv_window_create_ca_layer_host_view(root_data->cocoa_window, context_id);
+    else
+    {
+        macdrv_window_create_ca_layer_host_view_frame(root_data->cocoa_window, context_id, CGRectNull, z);
+        set_hosted_remote_layer(hwnd, context_id, TRUE);
+    }
+}
+
+/* A window moved, resized or changed z-order: place the layers hosted under its top-level
+ * window again (a sibling's change can reorder or uncover them too). */
+static void update_hosted_remote_layers(HWND hwnd)
+{
+    struct macdrv_win_data *root_data;
+    struct remote_layer *items;
+    unsigned int count, i;
+    HWND root;
+
+    pthread_mutex_lock(&remote_layers_mutex);
+    count = hosted_remote_layers.count;
+    pthread_mutex_unlock(&remote_layers_mutex);
+    if (!count || !(root = NtUserGetAncestor(hwnd, GA_ROOT))) return;
+
+    if (!(items = remote_layers_under(&hosted_remote_layers, root, FALSE, &count))) return;
+    if (count && (root_data = get_win_data(root)))
+    {
+        if (root_data->cocoa_window)
+            for (i = 0; i < count; i++) host_remote_layer(items[i].hwnd, root_data, items[i].context_id);
+        release_win_data(root_data);
+    }
+    free(items);
+}
+
+static void attach_pending_remote_layers(struct macdrv_win_data *data)
+{
+    struct remote_layer *items;
+    unsigned int count, i;
+
+    /* host_remote_layer() takes the mutex too, so it runs on a copy. */
+    if (!(items = remote_layers_under(&pending_remote_layers, data->hwnd, TRUE, &count))) return;
+    for (i = 0; i < count; i++)
+    {
+        TRACE("hwnd %p: attaching pending remote layer %u\n", items[i].hwnd, items[i].context_id);
+        host_remote_layer(items[i].hwnd, data, items[i].context_id);
+    }
+    free(items);
+}
