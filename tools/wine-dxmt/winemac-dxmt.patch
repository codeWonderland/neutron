+/***********************************************************************
+ *              macdrv_get_window_content_view
+ */
+WineContentView *macdrv_get_window_content_view(WineWindow *window)
+{
+    __block WineContentView *view;
+
+    OnMainThread(^{
+        view = [window contentView];
+    });
+
+    return view;
+}
+
+/***********************************************************************
+ *              macdrv_view_create_new_metal_view
+ *
+ * Like macdrv_view_create_metal_view(), but always creates a new view
+ * instead of reusing the content view's cached one, so external Metal
+ * renderers (DXMT, D3DMetal) can release it with
+ * macdrv_view_release_metal_view().
+ */
+WineMetalView *macdrv_view_create_new_metal_view(WineContentView *view, id<MTLDevice> device)
+{
+    __block WineMetalView *metalView = nil;
+
+    OnMainThread(^{
+        metalView = [[WineMetalView alloc] initWithFrame:[view bounds] device:device];
+        [metalView setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+        [view setAutoresizesSubviews:YES];
+        [view addSubview:metalView positioned:NSWindowBelow relativeTo:nil];
+        [(WineWindow*)view.window windowDidDrawContent];
+    });
+
+    return metalView;
+}
+
+/***********************************************************************
+ *              macdrv_on_main_thread
+ */
+void macdrv_on_main_thread(void *block)
+{
+    OnMainThread((dispatch_block_t)block);
+}
+
 @protocol WineMetalSwapChain <NSObject>
 
 - (CAMetalLayer*) layer;
