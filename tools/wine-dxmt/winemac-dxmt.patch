+/***********************************************************************
+ *              External Metal renderers (DXMT, D3DMetal)
+ *
+ * DXMT and Apple's D3DMetal present through winemac: they look up
+ * `macdrv_functions` with dlsym(). The table and window data below follow
+ * the layout they expect (CrossOver's), which differs from this driver's
+ * struct macdrv_win_data, so window data is handed out as a copy.
+ */
+struct external_win_data
+{
+    HWND                     hwnd;
+    WineWindow              *cocoa_window;
+    WineContentView         *cocoa_view;
+    WineContentView         *client_cocoa_view;
+    struct macdrv_win_data  *data;
+};
+
+static struct external_win_data *external_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct external_win_data *ret;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!data->cocoa_window || !(ret = malloc(sizeof(*ret))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+    ret->hwnd = hwnd;
+    ret->cocoa_window = data->cocoa_window;
+    ret->cocoa_view = macdrv_get_window_content_view(data->cocoa_window);
+    ret->client_cocoa_view = ret->cocoa_view;
+    ret->data = data;
+    return ret;
+}
+
+static void external_release_win_data(struct external_win_data *external)
+{
+    if (!external) return;
+    release_win_data(external->data);
+    free(external);
+}
+
+struct external_macdrv_functions
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct external_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct external_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    id_MTLDevice (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(id_MTLDevice d);
+    WineMetalView *(*macdrv_view_create_metal_view)(WineContentView *v, id_MTLDevice d);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *v);
+    void (*macdrv_view_release_metal_view)(WineMetalView *v);
+    void (*on_main_thread)(void *block);
+};
+
+__attribute__((visibility("default"))) const struct external_macdrv_functions macdrv_functions =
+{
+    NULL,  /* macdrv_init_display_devices: not in this driver */
+    external_get_win_data,
+    external_release_win_data,
+    macdrv_get_cocoa_window,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    macdrv_view_create_new_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    macdrv_on_main_thread,
+};
