+/***********************************************************************
+ *              macdrv_window_create_metal_view
+ *
+ * Creates a new Metal view filling a window's content view, for external
+ * Metal renderers (DXMT). Unlike -newMetalViewWithDevice:, the view isn't
+ * cached, so it can be released with macdrv_view_release_metal_view().
+ */
+WineMetalView *macdrv_window_create_metal_view(WineWindow *window, id<MTLDevice> device)
+{
+    __block WineMetalView *metalView = nil;
+
+    OnMainThread(^{
+        WineContentView *view = [window contentView];
+        if (!view) return;
+        metalView = [[WineMetalView alloc] initWithFrame:[view bounds] device:device];
+        [metalView setAutoresizingMask:NSViewWidthSizable | NSViewHeightSizable];
+        [view setAutoresizesSubviews:YES];
+        [view addSubview:metalView positioned:NSWindowBelow relativeTo:nil];
+        [window windowDidDrawContent];
+    });
+
+    return metalView;
+}
