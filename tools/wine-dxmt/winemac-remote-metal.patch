+/* Remote layers (CAContext IDs) another process asked this window to host before it had a
+ * Cocoa window, e.g. Chromium's GPU process presenting before Steam's window is shown.
+ * They're attached once create_cocoa_window() runs. */
+static pthread_mutex_t pending_remote_layers_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { HWND hwnd; unsigned int context_id; } pending_remote_layers[32];
+
+static void set_pending_remote_layer(HWND hwnd, unsigned int context_id, BOOL add)
+{
+    unsigned int i;
+
+    pthread_mutex_lock(&pending_remote_layers_mutex);
+    for (i = 0; i < ARRAY_SIZE(pending_remote_layers); i++)
+    {
+        if (add && !pending_remote_layers[i].hwnd)
+        {
+            pending_remote_layers[i].hwnd = hwnd;
+            pending_remote_layers[i].context_id = context_id;
+            break;
+        }
+        if (!add && pending_remote_layers[i].hwnd == hwnd && pending_remote_layers[i].context_id == context_id)
+            pending_remote_layers[i].hwnd = 0;
+    }
+    pthread_mutex_unlock(&pending_remote_layers_mutex);
+}
+
+/* Shows another process's layer for hwnd in root's Cocoa window: filling it when hwnd is the
+ * top-level window or covers its whole area, otherwise over hwnd's client area. */
+/* Remote layers this process hosts for child windows, so they can follow the child when it
+ * moves or resizes (update_hosted_remote_layers). */
+static struct { HWND hwnd; unsigned int context_id; } hosted_remote_layers[32];
+
+static void set_hosted_remote_layer(HWND hwnd, unsigned int context_id, BOOL add)
+{
+    unsigned int i, free_slot = ARRAY_SIZE(hosted_remote_layers);
+
+    pthread_mutex_lock(&pending_remote_layers_mutex);
+    for (i = 0; i < ARRAY_SIZE(hosted_remote_layers); i++)
+    {
+        if (hosted_remote_layers[i].hwnd == hwnd && hosted_remote_layers[i].context_id == context_id)
+        {
+            if (!add) hosted_remote_layers[i].hwnd = 0;
+            free_slot = ~0u;
+            break;
+        }
+        if (!hosted_remote_layers[i].hwnd && free_slot == ARRAY_SIZE(hosted_remote_layers)) free_slot = i;
+    }
+    if (add && free_slot < ARRAY_SIZE(hosted_remote_layers))
+    {
+        hosted_remote_layers[free_slot].hwnd = hwnd;
+        hosted_remote_layers[free_slot].context_id = context_id;
+    }
+    pthread_mutex_unlock(&pending_remote_layers_mutex);
+}
+
+static void host_remote_layer(HWND hwnd, struct macdrv_win_data *root_data, unsigned int context_id)
+{
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI);
+    RECT rect, visible = root_data->rects.visible;
