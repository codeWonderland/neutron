+/***********************************************************************
+ *              try_get_win_data
+ *
+ * Like get_win_data, but returns NULL instead of waiting when another thread holds the lock.
+ * For callers that run under win32u locks (window surface flushes), which threads holding
+ * the lock take next, e.g. macdrv_WindowPosChanged calling NtUserGetWindowLongW.
+ */
+struct macdrv_win_data *try_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+
+    if (!hwnd) return NULL;
+    if (pthread_mutex_trylock(&win_data_mutex)) return NULL;
     if (win_datas && (data = (struct macdrv_win_data*)CFDictionaryGetValue(win_datas, hwnd)))
         return data;
     pthread_mutex_unlock(&win_data_mutex);
