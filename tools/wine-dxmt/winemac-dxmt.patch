+/***********************************************************************
+ *              DXMT interface
+ *
+ * DXMT (https://github.com/3Shain/dxmt) presents through winemac: its unix
+ * library looks up `macdrv_functions` with dlsym(). The table and window data
+ * below follow the layout DXMT expects (CrossOver's), which differs from this
+ * driver's struct macdrv_win_data, so window data is handed out as a copy.
+ */
+struct dxmt_win_data
+{
+    HWND                     hwnd;
+    WineWindow              *cocoa_window;
+    void                    *cocoa_view;
+    void                    *client_cocoa_view;  /* passed back to create_metal_view */
+    struct macdrv_win_data  *data;
+};
+
+static struct dxmt_win_data *dxmt_get_win_data(HWND hwnd)
+{
+    struct macdrv_win_data *data;
+    struct dxmt_win_data *ret;
+
+    if (!(data = get_win_data(hwnd))) return NULL;
+    if (!data->cocoa_window || !(ret = malloc(sizeof(*ret))))
+    {
+        release_win_data(data);
+        return NULL;
+    }
+    ret->hwnd = hwnd;
+    ret->cocoa_window = data->cocoa_window;
+    /* DXMT only uses the client view as a handle for create_metal_view, so
+       hand it the window; dxmt_create_metal_view draws into its content view. */
+    ret->cocoa_view = data->cocoa_window;
+    ret->client_cocoa_view = data->cocoa_window;
+    ret->data = data;
+    return ret;
+}
+
+static void dxmt_release_win_data(struct dxmt_win_data *dxmt)
+{
+    if (!dxmt) return;
+    release_win_data(dxmt->data);
+    free(dxmt);
+}
+
+static WineMetalView *dxmt_create_metal_view(void *view, id_MTLDevice device)
+{
+    return macdrv_window_create_metal_view(view, device);
+}
+
+struct dxmt_macdrv_functions
+{
+    void (*macdrv_init_display_devices)(BOOL);
+    struct dxmt_win_data *(*get_win_data)(HWND hwnd);
+    void (*release_win_data)(struct dxmt_win_data *data);
+    WineWindow *(*macdrv_get_cocoa_window)(HWND hwnd, BOOL require_on_screen);
+    id_MTLDevice (*macdrv_create_metal_device)(void);
+    void (*macdrv_release_metal_device)(id_MTLDevice d);
+    WineMetalView *(*macdrv_view_create_metal_view)(void *v, id_MTLDevice d);
+    CAMetalLayer *(*macdrv_view_get_metal_layer)(WineMetalView *v);
+    void (*macdrv_view_release_metal_view)(WineMetalView *v);
+    void (*on_main_thread)(void *block);
+};
+
+__attribute__((visibility("default"))) const struct dxmt_macdrv_functions macdrv_functions =
+{
+    NULL,
+    dxmt_get_win_data,
+    dxmt_release_win_data,
+    NULL,
+    macdrv_create_metal_device,
+    macdrv_release_metal_device,
+    dxmt_create_metal_view,
+    macdrv_view_get_metal_layer,
+    macdrv_view_release_metal_view,
+    NULL,
+};
